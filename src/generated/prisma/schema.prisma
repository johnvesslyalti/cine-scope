// ===============================================
// GENERATOR & DATASOURCE
// ===============================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===============================================
// BETTER AUTH REQUIRED MODELS
// ===============================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Your custom fields
  bio  String? @db.VarChar
  role String  @default("user")

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // Your app relations
  watchlists  Watchlist[]
  reviews     Review[]
  preferences UserPreference[]
  followers   Follow[]         @relation("Following")
  following   Follow[]         @relation("Followers")
  searchLogs  SearchLog[]
  aiQueryLogs AIQueryLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ===============================================
// YOUR APPLICATION MODELS
// ===============================================

model Movie {
  id             String   @id @default(uuid())
  tmdbId         String   @unique
  title          String
  releaseYear    Int
  runtimeMinutes Int?
  posterUrl      String
  backdropUrl    String
  genres         String[]
  director       String?
  cast           String[]
  plotSummary    String?  @db.VarChar
  ratingImdb     Float?
  ratingTmdb     Float?

  // Relations
  watchlists  Watchlist[]
  reviews     Review[]
  preferences UserPreference[]
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId])
}

model UserPreference {
  id          String    @id @default(uuid())
  userId      String
  movieId     String
  rating      Int?
  isWatched   Boolean   @default(false)
  lastWatched DateTime?

  // AI Personalization flags
  isRecommended Boolean @default(false)
  isHidden      Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  score     Int
  text      String   @db.VarChar
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId])
}

model Follow {
  followerId  String
  followingId String

  follower  User @relation("Following", fields: [followerId], references: [id])
  following User @relation("Followers", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

model SearchLog {
  id        String   @id @default(uuid())
  userId    String?
  query     String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model AIQueryLog {
  id        String   @id @default(uuid())
  userId    String?
  prompt    String
  response  String?  @db.VarChar
  type      String // e.g. "summary" | "recommendation" | "comparison"
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
