// ===============================================
// GENERATOR & DATASOURCE
// ===============================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===============================================
// USER & AUTH MODELS (Better Auth Compatible)
// ===============================================

model User {
  id            String   @id @default(cuid())
  name          String   @unique
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  bio           String?  @db.VarChar(500)
  role          String   @default("user") // NEW: "user" | "admin"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // App Relations
  watchlists  Watchlist[]
  reviews     Review[]
  preferences UserPreference[]
  followers   Follow[]         @relation("Following")
  following   Follow[]         @relation("Followers")
  searchLogs  SearchLog[]
  aiQueryLogs AIQueryLog[]
}

// ===============================================
// MOVIE MODEL
// ===============================================

model Movie {
  id             String   @id @default(uuid())
  tmdbId         String   @unique
  title          String
  releaseYear    Int
  runtimeMinutes Int?
  posterUrl      String
  genres         String[]
  director       String?
  cast           String[]
  plotSummary    String?  @db.VarChar(5000)
  ratingImdb     Float?
  ratingTmdb     Float?

  // Relations
  watchlists  Watchlist[]
  reviews     Review[]
  preferences UserPreference[]
}

// ===============================================
// WATCHLIST MODEL
// ===============================================

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId])
}

// ===============================================
// USER PREFERENCES
// ===============================================

model UserPreference {
  id          String    @id @default(uuid())
  userId      String
  movieId     String
  rating      Int?
  isWatched   Boolean   @default(false)
  lastWatched DateTime?

  // AI Personalization flags
  isRecommended Boolean @default(false)
  isHidden      Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId])
}

// ===============================================
// REVIEW MODEL
// ===============================================

model Review {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  score     Int
  text      String   @db.VarChar(5000)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId])
}

// ===============================================
// FOLLOW SYSTEM (SOCIAL)
// ===============================================

model Follow {
  followerId  String
  followingId String

  follower  User @relation("Following", fields: [followerId], references: [id])
  following User @relation("Followers", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

// ===============================================
// SEARCH LOGS (ADMIN ANALYTICS)
// ===============================================

model SearchLog {
  id        String   @id @default(uuid())
  userId    String?
  query     String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

// ===============================================
// AI QUERY LOG (GEMINI ANALYTICS)
// ===============================================

model AIQueryLog {
  id        String   @id @default(uuid())
  userId    String?
  prompt    String
  response  String?  @db.VarChar(5000)
  type      String // e.g. "summary" | "recommendation" | "comparison"
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
